# harvest.env: names for the picking pipeline. Sourced by harvest/scripts/*.
# ⚠️ LOCK these before the first recorded episode. Changing any of them later makes earlier
#    episodes incompatible (dataset name, task string) or unreadable by the policy.

# Hub dataset for teleop demonstrations. Recorded with --dataset.no_stamp=true, so this exact name.
DATASET=$HF_USER/blush_pick_v1          # placeholder name. Log it in harvest/datasets.md.
DATASET_CLEAN=${DATASET}_clean          # bad episodes deleted, written by lerobot-edit-dataset

# ⚠️ SmolVLA conditions on this string. It must be IDENTICAL in record, train and rollout.
# Placeholder: the vault notes still say "truss", but the module picks single fruits.
TASK="Pick the ripe cherry tomato and place it in the crate"

# Policy repos on the Hub
ACT_POLICY=$HF_USER/act_blush_pick_v1
SMOLVLA_POLICY=$HF_USER/smolvla_blush_pick_v1

# Episode timing (vault note 03 starting values)
EPISODE_S=30        # one approach-pick-place-return
RESET_S=40          # time to re-hang fruit at the next planned cell. Raise it if re-hanging runs over.
SESSION_EPISODES=25 # fatigue shows in the data after ~25
