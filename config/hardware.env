# hardware.env — shared SO-101 rig facts. Sourced by every script in harvest/ and ripeness/.
# Change a value here, not in a script.

# ⚠️ Arms by stable by-id path, NEVER /dev/ttyACM*: those swapped on 2026-09-20 and inverted teleop.
# Voltage tells them apart: follower ~12 V on the PSU, leader ~4.6 V (logic only, that's normal).
FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B7B014343-if00
LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B7B014877-if00

# ⚠️ Omitting these writes calibration to None.json, which a run with an id never reads.
FOLLOWER_ID=follower_white
LEADER_ID=leader_black

# ⚠️ false everywhere. The degrees path of _unnormalize doesn't clamp, which caused the wrist_roll runaway.
USE_DEGREES=false

# Camera indices from the vault's Commands.md (2026-09). ⚠️ They can change between boots, so check
# with `lerobot-find-cameras opencv` or `v4l2-ctl --list-devices` at the start of a session.
# Both cameras are InnoMaker U20CAM-1080P. Checked 2026-10-09 with one plugged in (showed as /dev/video2):
#   MJPG 640x480 and 1920x1080 both measured at 29.5 fps. YUYV 1080p is only 5 fps, so always request MJPG.
# ⚠️ The camera reports serial "SN0001", so two identical units will very likely share one
#    /dev/v4l/by-id/ name. Tell them apart by USB PORT (/dev/v4l/by-path/...) and always plug each
#    camera into the same port. Fill in the paths below once both are connected (ls -l /dev/v4l/by-path/).
#    The 2026-10-09 test port was pci-0000:c6:00.3-usb-0:2:1.0-video-index0.
CLAW_CAM=2        # wrist/gripper camera, makes the ripeness call
BIRDSEYE_CAM=4    # birdseye mast, steers the arm
CLAW_CAM_PATH=        # /dev/v4l/by-path/...-video-index0, TODO when both cameras are plugged in
BIRDSEYE_CAM_PATH=    # same
CAM_W=640         # lerobot default, and what both the gate and the policy are trained on
CAM_H=480
CAM_FPS=30

# ⚠️ h264_nvenc (what vcodec=auto picks) fails on frame 1 on this laptop (RTX 1000 Ada). AV1 works.
VCODEC=libsvtav1

# Hugging Face user (not the GitHub user krishaanth5831)
HF_USER=krish5831

# lerobot checkout + env
LEROBOT_DIR=$HOME/Desktop/personal_projects/github/lerobot
