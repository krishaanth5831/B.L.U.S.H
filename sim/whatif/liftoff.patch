+    def _lift(self, x_rel, p, pitch, tilt, r):
+        """The open jaw straight up LIFT_M from the release pose, clear of everything but the target (as the way home
+        is checked): the grip point p straight up with the orientation held when that reaches the whole way, else the
+        grip point straight up with the orientation free (the longer of the two clear prefixes). ⚠️ At the release
+        poses of the 4 target seeds the orientation held only 12-36 mm up; the grip point alone went 80 mm, the
+        fingers flattening from 26-35 to 2-12 deg pitch (probe_reach.py, bare-arm IK, 2026-11-16). Sets
+        self._lift_why (how, and why it stopped) and self._lift_m (height reached). [x_rel] alone if none."""
+        self._lift_why, self._lift_m = None, 0.0
+        if LIFT_M <= 0:
+            return [x_rel]
+        point = truss_ik.cut_point_in_gripper(r)
+        self.jaw(tx.JAW_OPEN_DEG)
+        kw = dict(ignore=self.target_all, firm=False, **self.kw)
+        heights = LIFT_M * np.linspace(0, 1, LIFT_STEPS)[1:]
+
+        def prefix(cands):
+            xs, why = [x_rel], "full"
+            for x in cands:
+                if x is None:
+                    return xs, "no IK"
+                if float(np.abs(np.asarray(x) - xs[-1]).max()) > LIFT_JUMP_RAD:
+                    return xs, "IK jump"
+                if not self.chk.segment_free(xs[-1], np.asarray(x), **kw):
+                    return xs, "blocked"
+                xs.append(np.asarray(x))
+            return xs, why
+
+        def line(step):
+            out, x = [], x_rel
+            for z in heights:
+                x = step(x, p + [0, 0, z])
+                out.append(x)
+                if x is None:
+                    break
+            return out
+
+        xs, why = prefix(line(lambda x0, g: self.ik_free.solve(g, pitch, tilt, point, x0=x0)))
+        how = "held"
+        self._lift_held = f"{(len(xs) - 1) * 1000 * LIFT_M / (LIFT_STEPS - 1):.0f} mm, {why}"   # log only
+        if len(xs) < LIFT_STEPS:
+            ys, why_y = prefix(line(lambda x0, g: self._grip_to(x0, g, point)))
+            if len(ys) > len(xs):
+                xs, why, how = ys, why_y, "grip point only"
+        self._lift_m = float(self.ik_free.frame(xs[-1], point)[0][2] - p[2])
+        self._lift_why = f"{how}: {why}"
+        return xs
+
+    def _grip_to(self, x0, goal, point, iters=200):
+        """Joint angles (5, rad) putting the grip point at goal, orientation free: damped least squares from x0 on
+        the bare arm (self.ik_free). None if it ends more than 2 mm off (ArmIK.solve's tolerance)."""
+        ik, x = self.ik_free, np.asarray(x0, float).copy()
+        for _ in range(iters):
+            o, R = ik.fk(x)
+            g = o + R @ point
+            e = goal - g
+            if np.linalg.norm(e) < 1e-4:
+                break
+            J = np.empty((3, 5))
+            for k in range(5):
+                dx = np.zeros(5)
+                dx[k] = 1e-5
+                o2, R2 = ik.fk(x + dx)
+                J[:, k] = (o2 + R2 @ point - g) / 1e-5
+            x = np.clip(x + J.T @ np.linalg.solve(J @ J.T + 1e-4 * np.eye(3), e), self.lo, self.hi)
+        o, R = ik.fk(x)
+        return x if np.linalg.norm(goal - (o + R @ point)) < 0.002 else None
+
