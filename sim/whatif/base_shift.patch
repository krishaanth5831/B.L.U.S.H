+# --- base shift what-if (scene.BASE_DX; agents/shift 2026-11-17, not on dev) ---
+# The layout (trusses kept, the start-pose clearance drop, cut_ik / approach_ok, the ready draw, ripeness, the settle)
+# is drawn and judged exactly as at dx = 0 (_stock_world), then the model is composed again with the robot (arm, base
+# camera bracket, crate) moved and the settled state copied over. BLUSH_BASE_RECOMPOSE=1 does that at dx = 0 too
+# (a check that the recompose alone changes nothing).
+_STOCK_CACHE = {}
+_LAST_LAYOUT = None
+
+
+@contextlib.contextmanager
+def _stock_world():
+    """scene / crate / IK caches as at dx = 0 while the layout is drawn; the shifted ones again afterwards. The stock
+    IK caches are kept apart (_STOCK_CACHE) so neither phase ever sees the other's."""
+    global CRATE_CENTRE
+    import expert
+    import truss_expert
+    keep = (scene.ARM_BASE, scene.HOUSE_L, CRATE_CENTRE, truss_ik._IK, expert._IK, truss_expert._CRATE_POSES)
+    scene.ARM_BASE, scene.HOUSE_L, CRATE_CENTRE = scene.ARM_BASE_STOCK, scene.HOUSE_L_STOCK, STOCK_CRATE_CENTRE
+    truss_ik._IK, expert._IK, truss_expert._CRATE_POSES = (_STOCK_CACHE.get("ik"), _STOCK_CACHE.get("ik_free"),
+                                                           _STOCK_CACHE.get("crate_poses"))
+    try:
+        yield
+    finally:
+        _STOCK_CACHE.update(ik=truss_ik._IK, ik_free=expert._IK, crate_poses=truss_expert._CRATE_POSES)
+        scene.ARM_BASE, scene.HOUSE_L, CRATE_CENTRE = keep[:3]
+        truss_ik._IK, expert._IK, truss_expert._CRATE_POSES = keep[3:]
+
+
+# Variant B (BLUSH_SHIFT_CLEAR=1): the generator's own start-pose rule (_touching_arm on the fresh model, before the
+# settle, as _build_once) applied at the moved base; those trusses are left out, plus any named in SHIFT_DROP_EXTRA
+# (set by the runner: a dx = 0 run on a shifted run's thinned scene). BLUSH_NO_BRACKET=1: no base camera bracket (it
+# rides on the robot and stands in the plants once moved +x). State, colours, ctrl copied by name (nq changes).
+SHIFT_DROP_EXTRA = set()
+# Variant R (set by the runner): the target's name; every other truss whose knuckle is further along the row (+x, the
+# crate side) than the target's is left out. At dx 0 that asks: is it the plants on the crate side that block?
+CLEAR_RIGHT_OF = None
+
