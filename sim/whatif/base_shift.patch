+def _keys(m, kind):
+    """A stable key per joint / geom / equality / actuator: (owner body name, k-th of that kind on it)."""
+    seen, out = {}, []
+    for i in range(getattr(m, {"jnt": "njnt", "geom": "ngeom", "eq": "neq", "act": "nu"}[kind])):
+        if kind == "jnt":
+            k = (m.body(m.jnt_bodyid[i]).name,)
+        elif kind == "geom":
+            k = (m.body(m.geom_bodyid[i]).name,)
+        elif kind == "eq":
+            k = (m.eq(i).name, int(m.eq_obj1id[i]) >= 0 and m.body(m.eq_obj1id[i]).name)
+        else:
+            k = (m.actuator(i).name,)
+        seen[k] = seen.get(k, -1) + 1
+        out.append(k + (seen[k],))
+    return out
+
+
+def _copy_by_name(m, d, m2, d2):
+    nq = {0: 7, 1: 4, 2: 1, 3: 1}
+    nv = {0: 6, 1: 3, 2: 1, 3: 1}
+    # Keys missing from m are variant C's row copies: their joints stay at the model's initial pose (they settle in
+    # the plugin's settle), their colours come from the truss they copy (body name without the "r").
+    src = {k: i for i, k in enumerate(_keys(m, "jnt"))}
+    for j2, k in enumerate(_keys(m2, "jnt")):
+        if k not in src:
+            continue
+        j = src[k]
+        assert m.jnt_type[j] == m2.jnt_type[j2]
+        a, a2, n = m.jnt_qposadr[j], m2.jnt_qposadr[j2], nq[int(m.jnt_type[j])]
+        d2.qpos[a2:a2 + n] = d.qpos[a:a + n]
+        v, v2, n = m.jnt_dofadr[j], m2.jnt_dofadr[j2], nv[int(m.jnt_type[j])]
+        d2.qvel[v2:v2 + n] = d.qvel[v:v + n]
+        d2.qacc_warmstart[v2:v2 + n] = d.qacc_warmstart[v:v + n]
+    src = {k: i for i, k in enumerate(_keys(m, "geom"))}
+    for g2, k in enumerate(_keys(m2, "geom")):
+        if k in src:
+            m2.geom_rgba[g2] = m.geom_rgba[src[k]]
+        elif k[0].startswith("r") and (k[0][1:],) + k[1:] in src:
+            m2.geom_rgba[g2] = m.geom_rgba[src[(k[0][1:],) + k[1:]]]
+    src = {k: i for i, k in enumerate(_keys(m, "eq"))}
+    for e2, k in enumerate(_keys(m2, "eq")):
+        if k in src:
+            d2.eq_active[e2] = d.eq_active[src[k]]
+    src = {k: i for i, k in enumerate(_keys(m, "act"))}
+    for u2, k in enumerate(_keys(m2, "act")):
+        d2.ctrl[u2] = d.ctrl[src[k]]
+    assert m.na == 0 and m.nmocap == 0
+    d2.time = d.time
+
+
+def _row_copy(vines, parts, trusses, L):
+    """Variant C (BLUSH_ROW_COPY=L): the same plants again L m further along the row (+x), so a base moved +x has
+    plants on its crate side too (the 0.74 m greenhouse's row ends at the last stem, x <= 0.48). Names get an "r"
+    (s0t1 -> rs0t1, stem0 -> stemr0); each XML piece sits in a <frame> moved by L."""
+    import copy as _copy
+    import re
+    ren = lambda s: re.sub(r'"(s\d+t\d+)', r'"r\1', s)   # noqa: E731
+    fr = lambda s: f'<frame pos="{L} 0 0">{s}</frame>'   # noqa: E731
+    vines_c = [fr(re.sub(r'name="stem(\d+)"', r'name="stemr\1"', v)) for v in vines]
+    parts_c = [(fr(ren(p[0])), fr(ren(p[1])), fr(ren(p[2])), ren(p[3]), ren(p[4])) for p in parts]
+    sh = np.array([L, 0.0, 0.0])
+    T = []
+    for t in trusses:
+        c = _copy.deepcopy(t)
+        c.update(name="r" + t["name"], knuckle=t["knuckle"] + sh, peduncle_end=t["peduncle_end"] + sh,
+                 rachis_end=t["rachis_end"] + sh, cut_zone=[p + sh for p in t["cut_zone"]],
+                 geoms=["r" + g for g in t["geoms"]], weld="r" + t["weld"], body="r" + t["body"],
+                 stem=100 + t["stem"])
+        for f in c["fruit"]:
+            f.update(tomato="r" + f["tomato"], pedicel="r" + f["pedicel"], eq="r" + f["eq"], geom="r" + f["geom"],
+                     pos=f["pos"] + sh, truss=c["name"])
+        T.append(c)
+    return vines_c, parts_c, T
+
+
+def _copies_clear(orig, copies):
+    """Indices of the copies that keep the generator's rules against the plants already there: no fruit within
+    another's fruit or stalk (truss.truss_xml avoid), nothing over the moved crate's keep-out (_over_crate)."""
+    placed = [(f["pos"], f["radius"]) for t in orig for f in t["fruit"]] + [s for t in orig for s in _stalk_spheres(t)]
+    ok = []
+    for k, c in enumerate(copies):
+        mine = [(f["pos"], f["radius"]) for f in c["fruit"]]
+        clash = any(np.linalg.norm(p - q) < r + s for p, r in mine for q, s in placed)
+        clash |= any(np.linalg.norm(p - f["pos"]) < r + f["radius"] for p, r in _stalk_spheres(c)
+                     for t in orig for f in t["fruit"])
+        if not clash and not _over_crate(c):
+            ok.append(k)
+    return ok
+
+
+def _recompose_b(m, d, info):
+    vines, parts, base_mount = _LAST_LAYOUT
+    if os.environ.get("BLUSH_NO_BRACKET") == "1":
+        base_mount = False
+    static = vines + ([scene.base_mount_xml()] if base_mount else [])
+    trusses = info["trusses"]
+    drop = set(SHIFT_DROP_EXTRA)
+    if CLEAR_RIGHT_OF is not None:
+        kx = next(t["knuckle"][0] for t in trusses if t["name"] == CLEAR_RIGHT_OF)
+        drop |= {t["name"] for t in trusses if t["name"] != CLEAR_RIGHT_OF and t["knuckle"][0] > kx}
+    if os.environ.get("BLUSH_SHIFT_CLEAR") == "1":
+        m1, d1 = _compose(static, parts, True)
+        _start_pose(m1, d1)
+        drop |= {trusses[k]["name"] for k in _touching_arm(m1, d1, trusses)}
+    keep = [k for k, t in enumerate(trusses) if t["name"] not in drop]
+    parts2, T = [parts[k] for k in keep], [trusses[k] for k in keep]
+    copies, row_L = [], None
+    if os.environ.get("BLUSH_ROW_COPY"):
+        # BLUSH_ROW_COPY = "L1,L2,..." (or ":"-separated): the first offset that leaves a copy hanging on the crate side of the base
+        # within NEAR_M (as the stock scenes have 1-2 trusses 3-10 cm right of the base), else the one leaving most
+        best = None
+        near_m = 0.12
+        for L in (float(v) for v in os.environ["BLUSH_ROW_COPY"].replace(":", ",").split(",")):
+            vc, pc, tc = _row_copy(vines, parts, trusses, L)
+            # only copies on the crate side of the base: the target's own side keeps the stock layout. Copy stems
+            # too: right of the base and STEM_GAP from every original stem (else a copy stem lands between the target
+            # and the base, a hard obstacle to the planner)
+            sx = [float(re.search(r'fromto="([-0-9.]+)', v).group(1)) for v in vines]
+            stems_ok = {i for i, x in enumerate(sx) if x + L > scene.ARM_BASE[0]
+                        and all(abs(x + L - x2) >= STEM_GAP for x2 in sx)}
+            vc = [v for i, v in enumerate(vc) if i in stems_ok]
+            ok = [k for k in _copies_clear(T, tc) if tc[k]["knuckle"][0] > scene.ARM_BASE[0]
+                  and tc[k]["stem"] - 100 in stems_ok]
+            m1, d1 = _compose(static + vc, parts2 + [pc[k] for k in ok], True)
+            _start_pose(m1, d1)
+            bad = {tc[ok[i - len(T)]]["name"] for i in _touching_arm(m1, d1, T + [tc[k] for k in ok])
+                   if i >= len(T)}
+            ok = [k for k in ok if tc[k]["name"] not in bad]
+            near = sum(0 < tc[k]["knuckle"][0] - scene.ARM_BASE[0] <= near_m for k in ok)
+            if best is None or (near > 0 and best[0] == 0) or (best[0] == 0 and near == 0 and len(ok) > len(best[4])):
+                best = (near, L, vc, pc, ok, tc)
+            if near > 0:
+                break
+        _, row_L, vc, pc, ok, tc = best
+        static, parts2 = static + vc, parts2 + [pc[k] for k in ok]
+        copies = [tc[k] for k in ok]
+    m2, d2 = _compose(static, parts2, True)
+    _copy_by_name(m, d, m2, d2)
+    mujoco.mj_forward(m2, d2)
+    new = {k: i for i, k in enumerate(keep)}
+    T = T + copies
+    info = dict(info, trusses=T, fruit=[f for t in T for f in t["fruit"]],
+                ready=[new[k] for k in info["ready"] if k in new],
+                reachable=[new[k] for k in info["reachable"] if k in new], crate=(CRATE_CENTRE, CRATE_SIZE),
+                base_dx=scene.BASE_DX, shift_dropped=sorted(drop), bracket=bool(base_mount),
+                row_copies=[c["name"] for c in copies], row_copy_L=row_L)
+    return m2, d2, info
+
+
+def _recompose(m, d, info):
+    """The dx = 0 scene (m, d, info) with the robot where scene.ARM_BASE / CRATE_CENTRE put it: same vines, same
+    trusses, same colours, the settled state copied."""
+    if (os.environ.get("BLUSH_SHIFT_CLEAR") == "1" or os.environ.get("BLUSH_NO_BRACKET") == "1" or SHIFT_DROP_EXTRA
+            or os.environ.get("BLUSH_ROW_COPY") or CLEAR_RIGHT_OF is not None):
+        return _recompose_b(m, d, info)
+    vines, parts, base_mount = _LAST_LAYOUT
+    m2, d2 = _compose(vines + ([scene.base_mount_xml()] if base_mount else []), parts, True)
+    for a in ("nq", "nv", "nu", "na", "nbody", "njnt", "ngeom", "neq", "nmocap"):
+        assert getattr(m2, a) == getattr(m, a), (a, getattr(m2, a), getattr(m, a))
+    names = lambda mm: [mm.geom(i).name for i in range(mm.ngeom)]   # noqa: E731
+    assert names(m2) == names(m), "geoms differ"
+    m2.geom_rgba[:] = m.geom_rgba                     # the ripeness colours build() set
+    for f in ("qpos", "qvel", "act", "ctrl", "qacc_warmstart", "eq_active", "mocap_pos", "mocap_quat"):
+        getattr(d2, f)[:] = getattr(d, f)
+    d2.time = d.time
+    mujoco.mj_forward(m2, d2)
+    info = dict(info, crate=(CRATE_CENTRE, CRATE_SIZE), base_dx=scene.BASE_DX)
+    return m2, d2, info
+
+
 def build(seed=0, arm=True, hold=False, base_mount=False):
+    """See _build. With scene.BASE_DX (or BLUSH_BASE_RECOMPOSE=1) the layout comes from the dx = 0 world and the
+    robot is moved afterwards (_recompose)."""
+    if not (arm and (scene.BASE_DX != 0.0 or os.environ.get("BLUSH_BASE_RECOMPOSE") == "1")):
+        return _build(seed, arm, hold, base_mount)
+    with _stock_world():
+        m, d, info = _build(seed, arm, hold, base_mount)
+    return _recompose(m, d, info)
+
+
